     /* Log start */
     guacd_log(GUAC_LOG_INFO, "Guacamole proxy daemon (guacd) version " VERSION " started");
+
+    /* The fnOS package supplies an absolute socket path inside its 0700 runtime directory. */
+    const int unix_socket = config->bind_host && config->bind_host[0] == '/';
+    if (unix_socket) {
+        struct sockaddr_un addr = { .sun_family = AF_UNIX };
+        if (strlen(config->bind_host) >= sizeof(addr.sun_path)) {
+            guacd_log(GUAC_LOG_ERROR, "Unix socket path is too long.");
+            return EXIT_FAILURE;
+        }
+        strcpy(addr.sun_path, config->bind_host);
+        socket_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+        if (socket_fd < 0 || bind(socket_fd, (struct sockaddr*) &addr, sizeof(addr)) < 0
+                || chmod(addr.sun_path, 0600) < 0) {
+            guacd_log(GUAC_LOG_ERROR, "Cannot bind private Unix socket: %s", strerror(errno));
+            return EXIT_FAILURE;
+        }
+        goto socket_bound;
+    }
 
